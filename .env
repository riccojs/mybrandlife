# Copy to .env.local (git-ignored) and fill in.

# Backend origin, without /api. Must be listed in the backend's CORS_ORIGIN.
VITE_API_URL=http://localhost:4000

# Same value as the backend's PUBLIC_API_KEY (sent as the x-api-key header).
VITE_PUBLIC_API_KEY=jhon@2250@!fA

# Saved on new accounts as `domain` (MyBrandLife lander domain).
VITE_BPS_DOMAIN=mybrandlife.me
